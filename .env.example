# =========================================================================
# MenQ — environment variables. Copy to .env.local and fill in real values.
# Only NEXT_PUBLIC_* are exposed to the browser. Never commit real secrets.
# Canonical names follow docs/must/ENV_AND_SECRETS.md.
# =========================================================================

# ── App ───────────────────────────────────────────────────────────────────
# Public production URL. Drives canonical / hreflang / OG / sitemap URLs.
# REQUIRED in production — otherwise these fall back to https://menq.example.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL is accepted as an alternative to NEXT_PUBLIC_APP_URL.

# ── Database (PostgreSQL + Prisma) ────────────────────────────────────────
# Production: managed PostgreSQL. Local dev: Docker/Neon/Supabase.
# If unset, the site still runs but leads are logged instead of persisted.
DATABASE_URL=

# ── Auth (admin panel, invite-only) ───────────────────────────────────────
# Sessions are opaque, DB-backed, SHA-256-hashed tokens — there is NO JWT
# secret to set (no AUTH_SECRET is read by the app).
SESSION_MAX_AGE=604800            # 7 days, in seconds
# Initial super admin (used once by `npm run db:seed`). In production the seed
# REFUSES to run without ADMIN_PASSWORD (no default-password account).
ADMIN_EMAIL=admin@menq.local
ADMIN_PASSWORD=

# ── Email lead notifications (SMTP via nodemailer) ────────────────────────
EMAIL_FROM=
EMAIL_TO_LEADS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Telegram lead notifications ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=

# ── Analytics (placeholder-ready; consent-gated) ──────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=

# ── Booking ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CALENDLY_URL=

# ── Spam / rate limiting ──────────────────────────────────────────────────
# Master switch. Set to "false" to disable limiting (e.g. load tests).
# The actual limits are tiered per IP / email / phone in code.
RATE_LIMIT_ENABLED=true
# Number of trusted reverse-proxy hops in front of the app, used to pick the
# real client IP from x-forwarded-for. Vercel = 1, nginx = 1, nginx behind
# Cloudflare = 2, etc.
TRUSTED_PROXY_COUNT=1

# ── Reserved / not yet wired (safe to leave blank) ────────────────────────
# NEXT_PUBLIC_META_PIXEL_ID=       # future: Meta Pixel
# TURNSTILE_SITE_KEY=              # future: Cloudflare Turnstile captcha
# TURNSTILE_SECRET_KEY=
