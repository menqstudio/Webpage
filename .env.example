# =========================================================================
# MenQ — environment variables. Copy to .env.local and fill in real values.
# Only NEXT_PUBLIC_* are exposed to the browser. Never commit real secrets.
# Canonical names follow docs/must/ENV_AND_SECRETS.md.
# =========================================================================

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=hy
NEXT_PUBLIC_SUPPORTED_LOCALES=hy,en,ru

# ── Database (PostgreSQL + Prisma) ────────────────────────────────────────
# Production: PostgreSQL. Local dev: a local/hosted Postgres (e.g. Neon, Supabase, Docker).
DATABASE_URL=

# ── Auth (admin panel, invite-only) ───────────────────────────────────────
AUTH_SECRET=
AUTH_URL=http://localhost:3000
SESSION_MAX_AGE=604800            # 7 days, in seconds
# Initial super admin (used once by `npm run db:seed`).
ADMIN_EMAIL=admin@menq.local
ADMIN_PASSWORD=

# ── Email lead notifications ──────────────────────────────────────────────
EMAIL_PROVIDER=smtp               # smtp | resend (default smtp via nodemailer)
EMAIL_FROM=
EMAIL_TO_LEADS=
EMAIL_API_KEY=                    # if using an API provider (e.g. Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Telegram lead notifications ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=

# ── Analytics (placeholder-ready) ─────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Booking ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CALENDLY_URL=

# ── Spam / rate limiting ──────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=600     # 10 minutes
RATE_LIMIT_MAX_REQUESTS=5

# ── Captcha (optional, later) ─────────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
